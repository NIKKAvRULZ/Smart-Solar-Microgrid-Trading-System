<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#334155">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtItemStation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Station Name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="STATUS"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#0F172A"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/txtItemDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtItemStation"
            android:text="YYYY-MM-DD | 00:00 - 00:00"
            android:textColor="#94A3B8"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtItemEnergy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtItemDateTime"
            android:text="Reserved: 0.0 kWh"
            android:textColor="#F59E0B"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>