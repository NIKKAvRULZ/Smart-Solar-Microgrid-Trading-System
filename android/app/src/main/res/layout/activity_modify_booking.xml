<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modify Booking"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes are blocked within 12 hours of the start time."
                android:textSize="14sp"
                android:textColor="#D32F2F"
                android:layout_marginBottom="32dp" />

            <!-- Station ID (Locked, users shouldn't change the station itself) -->
            <EditText
                android:id="@+id/editStationId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:enabled="false"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editBookingDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:focusable="false"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/editStartTime"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:background="@android:drawable/edit_text"
                    android:paddingStart="12dp"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/editEndTime"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:background="@android:drawable/edit_text"
                    android:paddingStart="12dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editEnergyAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:inputType="numberDecimal"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnUpdateBooking"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="UPDATE BOOKING"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#0066CC"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCancelBooking"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="CANCEL BOOKING"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#D32F2F" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#0066CC"
        app:itemTextColor="#0066CC" />

</RelativeLayout>